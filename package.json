{
	"name": "powerassistant",
	"version": "1.92.2",
	"description": "Obsidian plugin: record and summarize meetings, import your calendar, track commitments, and ask your notes anything",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "esbuild tests/tests.ts --bundle --format=cjs --outfile=tests.cjs && node tests.cjs",
		"deploy": "npm run build && node deploy.mjs"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "0.110.0",
		"@mozilla/readability": "0.6.0",
		"docx": "9.7.1",
		"fflate": "0.8.3",
		"gifenc": "1.0.3",
		"marked": "18.0.6",
		"turndown": "7.2.4"
	},
	"devDependencies": {
		"@codemirror/state": "6.5.0",
		"@codemirror/view": "6.38.6",
		"@types/node": "20.19.43",
		"@types/turndown": "5.0.6",
		"esbuild": "0.21.5",
		"obsidian": "1.13.1",
		"tslib": "2.8.1",
		"typescript": "5.9.3"
	}
}
